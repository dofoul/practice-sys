# ========================================================
# LOCAL (Docker) — скопируй в .env и поменяй значения
# ========================================================

# PostgreSQL (контейнер db)
POSTGRES_USER=praktik
POSTGRES_PASSWORD=praktik
POSTGRES_DB=praktik_db

# Подключение Prisma из контейнера app (host = имя сервиса "db")
DATABASE_URL="postgresql://praktik:praktik@db:5432/praktik_db"
# Для запуска Prisma/миграций с ХОСТА (не из контейнера):
# DATABASE_URL="postgresql://praktik:praktik@localhost:5432/praktik_db"

# Auth.js (NextAuth v5) — сгенерируй: openssl rand -base64 32
AUTH_SECRET="замени_на_случайную_строку_не_менее_32_символов"
AUTH_URL="http://localhost:3000"

# MinIO (S3-совместимое хранилище файлов, локально)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=praktik

# Endpoint для сервер-серверных запросов (внутри Docker)
MINIO_ENDPOINT="http://minio:9000"
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Endpoint для presigned URLs, открываемых браузером
MINIO_PUBLIC_ENDPOINT="http://localhost:9000"


# ========================================================
# VERCEL / PRODUCTION — переменные окружения в Vercel Dashboard
# ========================================================

# БД — создай бесплатную БД на https://neon.tech
# Используй "Pooled connection" URL (с ?sslmode=require&pgbouncer=true)
# DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/ndbname?sslmode=require&pgbouncer=true"

# Если нужны миграции — добавь отдельно DIRECT_URL (без pgbouncer):
# DIRECT_URL="postgresql://user:pass@ep-xxx.neon.tech/ndbname?sslmode=require"

# Auth — сгенерируй: openssl rand -base64 32
# AUTH_SECRET="сгенерированная_строка_минимум_32_символа"
# AUTH_URL не нужен на Vercel — подхватывается автоматически

# S3-совместимое хранилище — Cloudflare R2 (бесплатно 10GB)
# или AWS S3
# MINIO_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# MINIO_ACCESS_KEY="r2_access_key_id"
# MINIO_SECRET_KEY="r2_secret_access_key"
# MINIO_BUCKET="praktik"
# MINIO_PUBLIC_ENDPOINT="https://pub-xxx.r2.dev"  # если включён Public Access на R2
